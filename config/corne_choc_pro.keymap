            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp LS(A)>;
        };
        ci_e_l: ci_e_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp E>;
        };
        ci_e_u: ci_e_u {
