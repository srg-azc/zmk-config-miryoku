        nm_0: nm_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LS(N9)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        /* shifted Bluetooth select = select profile, then clear it */
        u_bt_sel_0_clr: u_bt_sel_0_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
        };
        u_bt_sel_1_clr: u_bt_sel_1_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
        };
        u_bt_sel_2_clr: u_bt_sel_2_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
        };
        u_bt_sel_3_clr: u_bt_sel_3_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
        };

        /* stand-alone ` ^ ~ on the Portuguese layout: dead key, then Space */
        pt_grave: pt_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp SPACE>;
        };
        pt_caret: pt_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp SPACE>;
        };
        pt_tilde: pt_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp NUHS &kp SPACE>;
        };

        /* dead key, then the vowel (_l = lower case, _u = upper case) */
        ac_a_l: ac_a_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp A>;
        };
        ac_a_u: ac_a_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp LS(A)>;
        };
        ac_e_l: ac_e_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp E>;
        };
        ac_e_u: ac_e_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp LS(E)>;
        };
        ac_i_l: ac_i_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp I>;
        };
        ac_i_u: ac_i_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp LS(I)>;
        };
        ac_o_l: ac_o_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp O>;
        };
        ac_o_u: ac_o_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp LS(O)>;
        };
        ac_u_l: ac_u_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp U>;
        };
        ac_u_u: ac_u_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp RBKT &kp LS(U)>;
        };
        gr_a_l: gr_a_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp A>;
        };
        gr_a_u: gr_a_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp LS(A)>;
        };
        gr_e_l: gr_e_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp E>;
        };
        gr_e_u: gr_e_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp LS(E)>;
        };
        gr_i_l: gr_i_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp I>;
        };
        gr_i_u: gr_i_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp LS(I)>;
        };
        gr_o_l: gr_o_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp O>;
        };
        gr_o_u: gr_o_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp LS(O)>;
        };
        gr_u_l: gr_u_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp U>;
        };
        gr_u_u: gr_u_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(RBKT) &kp LS(U)>;
        };
        ti_a_l: ti_a_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp NUHS &kp A>;
        };
        ti_a_u: ti_a_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp NUHS &kp LS(A)>;
        };
        ti_o_l: ti_o_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
