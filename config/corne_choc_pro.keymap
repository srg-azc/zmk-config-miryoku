            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp I>;
        };
        ci_i_u: ci_i_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp LS(I)>;
        };
        ci_o_l: ci_o_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
