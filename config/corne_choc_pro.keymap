        };
        ci_a_l: ci_a_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp LS(NUHS) &kp A>;
        };
        ci_a_u: ci_a_u {
