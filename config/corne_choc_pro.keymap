        };
    };

    /* Ç: tap C and V together */
    combos {
        compatible = "zmk,combos";
        combo_cedilla {
            timeout-ms = <40>;
            key-positions = <31 32>;
            bindings = <&kp SEMI>;
            layers = <0>;
        };
    };
};

/* Miryoku mouse movement tuning */
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <1500>;
    delay-ms = <0>;
};
